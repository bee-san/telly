{
  "name": "telly",
  "version": "0.8.1",
  "description": "An anime player for learning Japanese",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "prepare:hachidori": "node scripts/prepare-hachidori.mjs",
    "devserver": "cargo run --manifest-path src-tauri/Cargo.toml --features devserver --bin telly-devserver --",
    "release": "npm run prepare:hachidori && tauri build --config src-tauri/tauri.bundle.conf.json"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
